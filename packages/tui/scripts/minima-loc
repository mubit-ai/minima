#!/usr/bin/env bash
# minima-loc — run THIS worktree's minima with credentials loaded, from any cwd.
#
# Why it exists: the harness resolves `.env.harness`/`.env` relative to the CURRENT
# DIRECTORY, so running a worktree build from some other repo picks up that repo's env —
# not the credentials. The per-user store (keychain + ~/.minima-harness/config.env) is
# hydrated from any cwd, but it holds only the core keys, so extras like EXA_API_KEY and
# OPENROUTER_API_KEY would be missing. This wrapper exports them explicitly.
#
# Precedence is deliberately the same as the harness's own: an already-set shell variable
# always wins, then .env.harness, then .env, then keychain/config.env (loaded by the CLI
# itself). Nothing is printed — never echo a credential.
#
# Paths are derived from this script's location, so the worktree can be moved or renamed.
#   MINIMA_LOC_ENV_DIR=/path        where .env.harness/.env live (default: auto-detect)
#   MINIMA_LOC_FROM_SOURCE=1        run TS via bun instead of the compiled binary
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tui="$(cd "$here/.." && pwd)"
root="$(cd "$tui/../.." && pwd)"

env_dir="${MINIMA_LOC_ENV_DIR:-}"
if [ -z "$env_dir" ]; then
  # This worktree first (if someone dropped a .env in it), then the sibling main checkout,
  # which is where the credential files actually live.
  for cand in "$root" "$root/../minima"; do
    if [ -r "$cand/.env.harness" ] || [ -r "$cand/.env" ]; then
      env_dir="$(cd "$cand" && pwd)"
      break
    fi
  done
fi

load_env() {
  [ -r "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in '' | \#*) continue ;; *=*) ;; *) continue ;; esac
    key="${line%%=*}"
    val="${line#*=}"
    key="${key//[[:space:]]/}"
    [ -n "$key" ] || continue
    case "$val" in
      \"*\") val="${val#\"}" && val="${val%\"}" ;;
      \'*\') val="${val#\'}" && val="${val%\'}" ;;
    esac
    # Shell env wins — only fill what is unset or empty.
    if [ -z "${!key-}" ]; then export "$key=$val"; fi
  done <"$1"
}

if [ -n "$env_dir" ]; then
  load_env "$env_dir/.env.harness"
  load_env "$env_dir/.env"
fi

bin="$tui/dist/minima-loc"
if [ "${MINIMA_LOC_FROM_SOURCE:-0}" = "1" ] || [ ! -x "$bin" ]; then
  exec bun "$tui/src/cli/main.ts" "$@"
fi
exec "$bin" "$@"
